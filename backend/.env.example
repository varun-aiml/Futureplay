# Backend Environment Configuration Template
NODE_ENV=production
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority

# JWT & Session
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d
SESSION_SECRET=your_session_secret_key_here

# Frontend URL (for CORS and OAuth redirect)
FRONTEND_URL=https://sportstek-frontend.onrender.com

# Google OAuth (FuturePlay Web Client - project futureplay-461207)
GOOGLE_CLIENT_ID=590767155641-ikejvmm3i0e0gft4ic38u2l86joj925e.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://sportstek.onrender.com/api/auth/google/callback

# Email Service (Brevo)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=noreply@sportstek.com
EMAIL_FROM_NAME=Sportstek

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
